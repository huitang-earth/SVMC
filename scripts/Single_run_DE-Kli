#!/bin/bash

para1=$1
para2=$2
para3=$3
para4=$4
expid=$5
run_case=$6            # T or F, swtich for running long experiments

echo "para1: $para1"
echo "para2: $para2"
echo "para3: $para3"
echo "para4: $para4"
echo "expid: $expid"
echo "run_case: $run_case"

mkdir -p /projappl/project_2006422/svm_data/output/veg_sensitivty/$expid

######### Set "run_***" to "T" to run the site simulation
post_proc="F"         # T or F, swtich for archiving experiments. 

if [ ${run_case} == "T" ]
then

module load gcc/11.3.0 openmpi/4.1.4 netcdf-fortran/4.5.4

cd /projappl/project_2006422/svm_data/output/veg_sensitivty/$expid

