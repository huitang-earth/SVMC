  for year in {2017..2020}; do
    ncks --quench --mk_rec_dmn time SVM_DE-Kli.${year}.day_vegsen_${expid}.nc test_day_${year}_${expid}.nc
    ncks --quench --mk_rec_dmn time SVM_DE-Kli.${year}.hr_vegsen_${expid}.nc test_hr_${year}_${expid}.nc
