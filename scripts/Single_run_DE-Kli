#   cdo mergetime SVM_Qvidja.20*.hr_vegsen_${i}.nc SVM_Qvidja_hr_vegsen_${i}.nc

#  for year in {2018..2022}; do
#    ncks --quench --mk_rec_dmn time SVM_Qvidja.${year}.day_vegsen_${i}.nc test_day_${year}_${i}.nc
#    ncks --quench --mk_rec_dmn time SVM_Qvidja.${year}.hr_vegsen_${i}.nc test_hr_${year}_${i}.nc
#  done 
#  ncrcat test_day_*_${i}.nc  SVM_Qvidja_day_vegsen_${expid}.nc
#  ncrcat test_hr_*_${i}.nc  SVM_Qvidja_hr_vegsen_${expid}.nc

#   rm test_day_*_${i}.nc
#   rm test_hr_*_${i}.nc
